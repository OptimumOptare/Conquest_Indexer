# Required — the chain this indexer reads. Use a keyed endpoint in production; give the
# indexer its OWN key so a blown quota cannot take the game's RPC down with it.
RPC_HTTP=https://testnet-rpc.monad.xyz

# Monad testnet. Must match the chainId the frontend runs against — the client refuses a
# response from an indexer on another chain.
CHAIN_ID=10143

# Exact site origins allowed to read this service (comma separated, no trailing slash).
ALLOWED_ORIGINS=http://localhost:5173

# Where the SQLite file lives. On Railway this must be inside the mounted volume.
DB_PATH=./data/indexer.db

PORT=8787

# Cursor anchor: the AdminController deploy block of the current stack (T58 = 51988283).
# Changing this after a redeploy is part of the redeploy checklist — with a stale value the
# indexer serves a dead round's history.
START_BLOCK=51988283

# Tail cadence. ~0.4 s blocks means 1 s of polling is a few blocks per request.
POLL_INTERVAL_MS=1000

# Provider cap on one eth_getLogs span. Measured 100 on testnet-rpc.monad.xyz (2026-08-15) —
# a 1000-block range is rejected outright. Raise this on a keyed provider that allows more;
# it is the single biggest lever on how long the initial catch-up takes.
LOG_RANGE_MAX_BLOCKS=100
CATCHUP_CONCURRENCY=8
REORG_DEPTH_BLOCKS=128

# Contract addresses default to the T58 book compiled into src/config.ts. Override per contract
# after a redeploy if you do not want to cut a new image:
# ADDR_ADMIN_CONTROLLER=0x...
# ADDR_PLAYER_REGISTRY=0x...
# ADDR_ECONOMY=0x...
# ADDR_COMBAT=0x...
# ADDR_TECH_WEAPONS=0x...
# ADDR_DIPLOMACY=0x...
