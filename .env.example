# Required — the steady-state RPC. Every block-number / block-hash read and every tail
# eth_getLogs goes here, about 2-4 requests per POLL_INTERVAL_MS.
#
# A tail tick only ever asks for ~3 blocks of logs, so no provider's range cap matters here —
# the public endpoint's 100-block cap is 30x more than it needs. What this endpoint DOES need is
# a rate allowance that tolerates a request every second or two.
RPC_HTTP=https://testnet-rpc.monad.xyz

# Optional — wide-range endpoint used ONLY for eth_getLogs when the gap exceeds one
# LOG_RANGE_MAX_BLOCKS request: a cold start, or catching up after a long outage.
#
# Envio HyperRPC is the right endpoint for this. It has no observed getLogs range cap, so the
# entire history of the T58 stack (deploy -> tip, 1,996,341 blocks) came back in ONE
# request: 271 logs, 0.2 MB, 0.22 s (measured 2026-08-15). The same backfill is ~17,300
# requests against the public Monad RPC and ~200,000 against Alchemy's free tier.
#
# The split exists because of HyperRPC's advertised 5 requests/minute free tier. A cold start
# spends 1 request here and steady state spends 0, so the allowance is never the constraint.
# (Measured 99 req/min sustained without throttling, i.e. the documented limit is not currently
# enforced — this design does not rely on that staying true.)
#
# HyperRPC does NOT implement eth_call, which is why the game frontend cannot switch to it
# wholesale: the lens reads are all eth_call. That constraint does not apply to this service.
# BACKFILL_RPC_HTTP=https://10143.rpc.hypersync.xyz/<your-token>
BACKFILL_LOG_RANGE_MAX_BLOCKS=50000000

# Monad testnet. Must match the chainId the frontend runs against — the client refuses a
# response from an indexer on another chain.
CHAIN_ID=10143

# Exact site origins allowed to read this service (comma separated, no trailing slash).
ALLOWED_ORIGINS=http://localhost:5173

# Where the SQLite file lives. On Railway this must be inside the mounted volume.
DB_PATH=./data/indexer.db

PORT=8787

# Cursor anchor: the SchizoCore deploy block of the current stack (M23 = 63589123).
# Changing this after a redeploy is part of the redeploy checklist — with a stale value the
# indexer serves a dead round's history.
START_BLOCK=63589123

# Tail cadence. ~0.4 s blocks means 1 s of polling is a few blocks per request.
POLL_INTERVAL_MS=1000

# Range cap of RPC_HTTP. Measured 2026-08-15: 100 on testnet-rpc.monad.xyz (a 1000-block range
# is rejected), 10 on Alchemy's free tier. This also decides when BACKFILL_RPC_HTTP takes over —
# a gap wider than this is treated as a backfill.
LOG_RANGE_MAX_BLOCKS=100
# Parallel requests on RPC_HTTP: catch-up ranges and /positions aggregate3 batches. Never applied
# to the backfill endpoint.
CATCHUP_CONCURRENCY=4
REORG_DEPTH_BLOCKS=128

# /positions (U22.3) reads effectiveTroops for every (player, province) pair with eth_call on
# RPC_HTTP. That is the main reason RPC_HTTP should be this service's own key.
# Calls per aggregate3. Every Monad RPC caps eth_call gas, and the public endpoint's 30M is the
# lowest measured (Q-U35b). One call costs ~29k gas (measured 2026-10-11: 200 calls 5.8M, 1,000
# calls 29.0M), so 200, the UI's on-demand chunk size, leaves ~5x margin.
POSITIONS_BATCH_CALLS=200
# Full re-read of every pair: the check that no trigger is missing. Logs how many values it changed.
POSITIONS_SWEEP_MS=300000

# /leaderboard (U22.4) reads SchizoLens.getPlayer(player, all nations) for every registered player.
# One costs ~11.2M gas and each extra one in the same aggregate3 ~8.1M (measured 2026-10-11), so 2
# per batch fit the 30M gas limit below with ~35% margin. The limit is sent explicitly: with none,
# the public endpoint's default ran a 1-2 call batch out of gas.
LEADERBOARD_BATCH_CALLS=2
LEADERBOARD_CALL_GAS=30000000
# Full re-read of every player, the same check as POSITIONS_SWEEP_MS.
LEADERBOARD_SWEEP_MS=300000

# Contract addresses default to the M23 book compiled into src/config.ts. Override per contract
# after a redeploy if you do not want to cut a new image:
# ADDR_CORE=0x...   SchizoCore: the only log source (it emits the whole §16 catalogue)
# ADDR_LENS=0x...   SchizoLens: read-only views, never a log source
# ADDR_MULTICALL3=0x...  Multicall3 for /positions and /leaderboard; defaults to the canonical 0xcA11bde0...CA11
